{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowJs": false,
    "checkJs": false,
    "noEmit": true,
    "strict": true,
    "noImplicitOverride": true
  },
  "include": [
    "**/*.ts"
  ],
  "exclude": [
    "coverage",
    "dist",
    "node_modules",
    "test",
    "test/fixtures",
    "qualidade/artefatos"
  ]
}
