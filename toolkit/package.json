{
  "name": "sgc-scripts",
  "private": true,
  "type": "module",
  "description": "Toolkit unificado de scripts do SGC",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "sgc": "./sgc.js"
  },
  "exports": {
    ".": "./sgc.js",
    "./lib/*": "./lib/*.js"
  },
  "scripts": {
    "sgc": "node ./sgc.js",
    "deps:audit": "knip",
    "test": "vitest run",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "lint": "oxlint . --node-plugin --vitest-plugin --disable-unicorn-plugin -D correctness -D suspicious --ignore-pattern node_modules --ignore-pattern test/fixtures",
    "lint:fix": "oxlint . --node-plugin --vitest-plugin --disable-unicorn-plugin -D correctness -D suspicious --ignore-pattern node_modules --ignore-pattern test/fixtures --fix"
  },
  "dependencies": {
    "@vue/compiler-sfc": "^3.5.39",
    "commander": "^15.0.0",
    "consola": "^3.4.2",
    "dependency-cruiser": "^18.0.0",
    "execa": "^9.6.1",
    "fs-extra": "^11.3.6",
    "globby": "^16.2.0",
    "listr2": "^10.2.2",
    "openapi-typescript": "^7.13.0",
    "picocolors": "^1.1.1",
    "ts-morph": "^28.0.0",
    "which": "^7.0.0",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.9",
    "knip": "^6.23.0",
    "oxlint": "^1.72.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9"
  }
}
