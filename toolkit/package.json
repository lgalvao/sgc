{
  "name": "ferramentas-projeto",
  "version": "0.1.0",
  "type": "module",
  "description": "Toolkit TypeScript de auditoria e qualidade de projetos",
  "engines": {
    "node": ">=26.7.0"
  },
  "bin": {
    "ferramentas": "./binarios/ferramentas.cjs"
  },
  "files": [
    "binarios",
    "*.ts",
    "servidor/**/*.ts",
    "codigo/**/*.ts",
    "cliente/**/*.ts",
    "integracao/**/*.ts",
    "biblioteca/**/*.ts",
    "projeto/**/*.ts",
    "qualidade/**/*.ts",
    "qualidade/politicas/**/*.json",
    "qualidade/politicas/**/*.yml",
    "requisitos/**/*.ts",
    "README.md",
    "tsconfig.json",
    "tsconfig.estrito.json"
  ],
  "exports": {
    ".": "./ferramentas.ts",
    "./cobertura-java": "./biblioteca/dominios/cobertura-java.ts",
    "./cobertura-web": "./biblioteca/dominios/cobertura-web.ts",
    "./casos-de-uso": "./requisitos/casos-de-uso.ts"
  },
  "scripts": {
    "ferramentas": "tsx ./ferramentas.ts",
    "deps:audit": "knip",
    "build": "tsc --project tsconfig.build.json",
    "test": "vitest run --exclude testes/pacote.test.ts",
    "test:coverage": "vitest run --coverage --exclude testes/pacote.test.ts --coverage.exclude='testes/**'",
    "test:pacote": "vitest run testes/pacote.test.ts",
    "typecheck": "npm run typecheck:estrito",
    "typecheck:estrito": "tsc --noEmit --project tsconfig.estrito.json",
    "typecheck:testes": "tsc --noEmit --project tsconfig.testes.json",
    "lint": "oxlint . --node-plugin --vitest-plugin --disable-unicorn-plugin -D correctness -D suspicious --ignore-pattern node_modules --ignore-pattern testes/fixtures",
    "lint:fix": "oxlint . --node-plugin --vitest-plugin --disable-unicorn-plugin -D correctness -D suspicious --ignore-pattern node_modules --ignore-pattern testes/fixtures --fix"
  },
  "dependencies": {
    "@vue/compiler-sfc": "^3.5.39",
    "commander": "^15.0.0",
    "consola": "^3.4.2",
    "dependency-cruiser": "^18.2.0",
    "execa": "^9.6.1",
    "fs-extra": "^11.4.0",
    "globby": "^16.2.4",
    "listr2": "^10.2.2",
    "openapi-typescript": "^7.13.0",
    "picocolors": "^1.1.1",
    "serve-handler": "^6.1.7",
    "ts-morph": "^28.0.0",
    "which": "^7.0.0",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.9",
    "knip": "^6.32.2",
    "oxlint": "^1.80.0",
    "vitest": "^4.1.9"
  }
}
