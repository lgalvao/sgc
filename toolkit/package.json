{
  "name": "sgc-scripts",
  "private": true,
  "type": "module",
  "description": "Toolkit unificado de scripts do SGC",
  "engines": {
    "node": ">=26.7.0"
  },
  "bin": {
    "sgc": "./bin/sgc.cjs"
  },
  "exports": {
    ".": "./sgc.ts",
    "./lib/caminhos": "./lib/caminhos.ts",
    "./lib/cli-ajuda": "./lib/cli-ajuda.ts",
    "./lib/cli-opcoes": "./lib/cli-opcoes.ts",
    "./lib/configuracao": "./lib/configuracao.ts",
    "./lib/execucao": "./lib/execucao.ts",
    "./lib/logger": "./lib/logger.ts",
    "./lib/qualidade": "./lib/qualidade.ts",
    "./lib/saida": "./lib/saida.ts",
    "./lib/*": "./lib/*.ts"
  },
  "scripts": {
    "sgc": "tsx ./sgc.ts",
    "deps:audit": "knip",
    "build": "tsc --project tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "npm run typecheck:estrito",
    "typecheck:estrito": "tsc --noEmit --project tsconfig.estrito.json",
    "lint": "oxlint . --node-plugin --vitest-plugin --disable-unicorn-plugin -D correctness -D suspicious --ignore-pattern node_modules --ignore-pattern test/fixtures",
    "lint:fix": "oxlint . --node-plugin --vitest-plugin --disable-unicorn-plugin -D correctness -D suspicious --ignore-pattern node_modules --ignore-pattern test/fixtures --fix"
  },
  "dependencies": {
    "@vue/compiler-sfc": "^3.5.41",
    "commander": "^15.0.0",
    "consola": "^3.4.2",
    "dependency-cruiser": "^18.2.0",
    "execa": "^10.0.1",
    "fs-extra": "^11.4.0",
    "globby": "^16.2.3",
    "listr2": "^11.0.0",
    "picocolors": "^1.1.1",
    "ts-morph": "^28.0.0",
    "tsx": "^4.23.12",
    "which": "^7.0.0",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/which": "^3.0.4",
    "@types/xml2js": "^0.4.14",
    "@vitest/coverage-v8": "^4.1.10",
    "knip": "^6.32.2",
    "oxlint": "^1.78.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
