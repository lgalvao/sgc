{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowJs": false,
    "checkJs": false,
    "noEmit": true,
    "strict": true,
    "noImplicitOverride": true,
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "test/**/*.ts"
  ],
  "exclude": [
    "coverage",
    "dist",
    "node_modules"
  ]
}
