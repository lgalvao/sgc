{
  "name": "sgc",
  "description": "Sistema de Gestão de Competências",
  "version": "1.3.8",
  "type": "module",
  "engines": {
    "node": ">=26.7.0"
  },
  "workspaces": [
    "frontend",
    "toolkit",
    "e2e",
    "e2e-hom"
  ],
  "scripts": {
    "knip": "knip",
    "test": "npm --prefix frontend run test",
    "test:e2e": "playwright test --config=e2e/playwright.config.ts --project=chromium",
    "test:e2e:hom": "playwright test --config=e2e-hom/playwright.config.ts",
    "test:e2e:hom:ui": "playwright test --config=e2e-hom/playwright.config.ts --ui",
    "test:unit": "npm --prefix frontend run test:unit",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "sgc": "tsx toolkit/sgc.ts",
    "cheiros:auditar": "tsx toolkit/sgc.ts codigo cheiros auditar",
    "frontend:residuos": "tsx toolkit/sgc.ts frontend residuos auditar",
    "frontend:residuos:check": "tsx toolkit/sgc.ts frontend residuos validar",
    "frontend:arquitetura": "tsx toolkit/sgc.ts frontend arquitetura auditar",
    "qualidade:coletar": "tsx toolkit/sgc.ts qualidade coletar --perfil rapido",
    "lint:ox": "oxlint e2e toolkit eslint.config.js --ignore-pattern e2e/lifecycle.js",
    "lint": "npm run lint:ox && eslint e2e toolkit eslint.config.js --fix",
    "deps:audit": "knip",
    "deps:audit:all": "npm run deps:audit && npm --prefix frontend run deps:audit && npm --prefix toolkit run deps:audit",
    "release": "release-it"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "knip": "^6.32.2",
    "oxlint": "^1.78.0",
    "release-it": "^21.0.2",
    "typescript": "^6.0.3"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "vue-demi@0.14.10": true,
    "fsevents@2.3.2": true,
    "esbuild@0.28.2": true
  }
}
