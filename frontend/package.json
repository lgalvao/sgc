{
  "name": "sgc-frontend",
  "private": true,
  "version": "1.3.8",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "build": "vite build",
    "build:hom": "vite build --mode hom",
    "build:e2e": "vite build --mode e2e",
    "build:prod": "vite build --mode production",
    "lint:ox": "oxlint --ignore-path .oxlintignore .",
    "lint": "npm run lint:ox && eslint . --fix",
    "deps:audit": "knip",
    "typecheck": "vue-tsc --noEmit --skipLibCheck --incremental --strict",
    "test": "npm run test:unit",
    "test:unit": "vitest --run --reporter=dot --no-color",
    "coverage:unit": "vitest --run --coverage --reporter=dot --no-color",
    "coverage:unit:collect": "vitest --run --coverage --reporter=dot --no-color --coverage.thresholds.lines=0 --coverage.thresholds.functions=0 --coverage.thresholds.statements=0 --coverage.thresholds.branches=0",
    "residuos:audit": "tsx ../toolkit/ferramentas.ts frontend residuos auditar",
    "arquitetura:audit": "tsx ../toolkit/ferramentas.ts frontend arquitetura auditar",
    "arquitetura:gate": "tsx ../toolkit/ferramentas.ts frontend arquitetura validar",
    "modais:check": "tsx ../toolkit/ferramentas.ts frontend modais validar",
    "templates:check": "tsx ../toolkit/ferramentas.ts frontend views templates-validar",
    "residuos:check": "tsx ../toolkit/ferramentas.ts frontend residuos validar",
    "qualidade:testes": "npm run test:unit",
    "qualidade:lint": "oxlint --ignore-path .oxlintignore . && eslint . --max-warnings 0",
    "qualidade:tipos": "vue-tsc --noEmit --skipLibCheck --incremental --strict",
    "qualidade:completa": "npm run qualidade:testes && npm run qualidade:lint && npm run qualidade:tipos && npm run residuos:check && npm run arquitetura:gate && npm run templates:check && npm run modais:check"
  },
  "dependencies": {
    "@pinia/colada": "^1.4.6",
    "@tiptap/starter-kit": "^3.31.3",
    "@tiptap/vue-3": "^3.31.3",
    "@vue/devtools-api": "^8.2.1",
    "axios": "^1.20.0",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "bootstrap-vue-next": "^1.2.2",
    "date-fns": "^4.4.0",
    "html2canvas": "^1.4.1",
    "pinia": "^4.0.3",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@pinia/testing": "^2.0.1",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-links": "^10.6.0",
    "@storybook/vue3-vite": "^10.6.0",
    "@types/bootstrap": "^5.2.11",
    "@types/node": "^26.6.3",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/coverage-v8": "^5.0.2",
    "@vue/test-utils": "^2.5.1",
    "axe-core": "^4.13.0",
    "consola": "^3.4.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-storybook": "^10.6.0",
    "eslint-plugin-vue": "^10.11.1",
    "eslint-plugin-vuejs-accessibility": "^2.6.0",
    "fast-check": "^4.10.2",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "knip": "^6.38.0",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "rollup": "^4.63.5",
    "storybook": "^10.6.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11"
  }
}
